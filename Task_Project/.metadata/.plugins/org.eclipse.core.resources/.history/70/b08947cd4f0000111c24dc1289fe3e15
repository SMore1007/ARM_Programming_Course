/* ================= FAULT ENABLE ================= */

void enable_faults(void)
{
    uint32_t *SHCSR = (uint32_t *)0xE000ED24;

    *SHCSR |= (1 << 16);   // MemManage
    *SHCSR |= (1 << 17);   // BusFault
    *SHCSR |= (1 << 18);   // UsageFault
}
